# Copy to .env (git-ignored) and fill in your own values. All services are optional;
# offline mode, demos and QA need none of them.

# Story generation LLM (OpenAI-compatible) — pipeline/pipeline.py --mode llm
LLM_MODEL=
LLM_API_BASE=https://api.example.com/v1
LLM_API_KEY=

# Image generation (OpenAI Images compatible) — avg_engine/asset_generator.py
IMAGE_API_URL=https://api.example.com/v1/images/generations
IMAGE_API_KEY=

# avg_game_toolkit_v1 providers
GPT_IMAGE_BASE_URL=https://api.example.com/v1
GPT_IMAGE_API_KEY=
MINIMAX_BASE_URL=
MINIMAX_API_KEY=
ARK_API_KEY=
