{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local/interactive-video/character_world_bible.schema.json",
  "title": "Character And World Bible",
  "description": "Reusable contract for character, relationship, location, prop, and knowledge continuity across story, art, mechanics, audio, and runtime.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project_id",
    "characters",
    "locations",
    "props",
    "relationship_map",
    "knowledge_boundaries"
  ],
  "properties": {
    "project_id": {
      "type": "string"
    },
    "style_context": {
      "type": "string",
      "description": "World-level tone/style context shared by writing and art."
    },
    "characters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/character"
      }
    },
    "locations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/location"
      },
      "default": []
    },
    "props": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/prop"
      },
      "default": []
    },
    "relationship_map": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relationship"
      },
      "default": []
    },
    "knowledge_boundaries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/knowledge_boundary"
      },
      "default": []
    },
    "continuity_rules": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    }
  },
  "$defs": {
    "character": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "character_id",
        "display_name",
        "role",
        "public_profile",
        "private_truth",
        "desire",
        "fear",
        "contradiction",
        "relationship_to_player",
        "speech_style",
        "visual_anchors",
        "expression_needs",
        "arc"
      ],
      "properties": {
        "character_id": {
          "type": "string"
        },
        "display_name": {
          "type": "string"
        },
        "role": {
          "enum": [
            "player",
            "main_cast",
            "supporting_cast",
            "antagonist",
            "system",
            "other"
          ]
        },
        "public_profile": {
          "type": "string"
        },
        "private_truth": {
          "type": "string"
        },
        "desire": {
          "type": "string"
        },
        "fear": {
          "type": "string"
        },
        "contradiction": {
          "type": "string"
        },
        "relationship_to_player": {
          "type": "string"
        },
        "speech_style": {
          "type": "string"
        },
        "visual_anchors": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "do_not_change": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "expression_needs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/expression_need"
          },
          "minItems": 1
        },
        "arc": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/arc_stage"
          },
          "minItems": 1
        },
        "voice_direction": {
          "type": "string"
        }
      }
    },
    "expression_need": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expression",
        "dramatic_use",
        "asset_slot"
      ],
      "properties": {
        "expression": {
          "type": "string"
        },
        "dramatic_use": {
          "type": "string"
        },
        "asset_slot": {
          "type": "string"
        }
      }
    },
    "arc_stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage_id",
        "player_visible_change",
        "trigger"
      ],
      "properties": {
        "stage_id": {
          "type": "string"
        },
        "player_visible_change": {
          "type": "string"
        },
        "trigger": {
          "type": "string"
        }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "location_id",
        "display_name",
        "narrative_function",
        "visual_anchors",
        "asset_slots"
      ],
      "properties": {
        "location_id": {
          "type": "string"
        },
        "display_name": {
          "type": "string"
        },
        "narrative_function": {
          "type": "string"
        },
        "visual_anchors": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "ambient_direction": {
          "type": "string"
        },
        "asset_slots": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      }
    },
    "prop": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prop_id",
        "display_name",
        "story_function",
        "visual_anchors",
        "first_appearance_node_id"
      ],
      "properties": {
        "prop_id": {
          "type": "string"
        },
        "display_name": {
          "type": "string"
        },
        "story_function": {
          "type": "string"
        },
        "visual_anchors": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "first_appearance_node_id": {
          "type": "string"
        },
        "asset_slots": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from_character_id",
        "to_character_id",
        "initial_state",
        "pressure_point",
        "possible_change"
      ],
      "properties": {
        "from_character_id": {
          "type": "string"
        },
        "to_character_id": {
          "type": "string"
        },
        "initial_state": {
          "type": "string"
        },
        "pressure_point": {
          "type": "string"
        },
        "possible_change": {
          "type": "string"
        }
      }
    },
    "knowledge_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_id",
        "knows_at_start",
        "hidden_until",
        "reveal_condition"
      ],
      "properties": {
        "subject_id": {
          "type": "string"
        },
        "knows_at_start": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "hidden_until": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "reveal_condition": {
          "type": "string"
        }
      }
    }
  }
}

