{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local/interactive-video/coherence_matrix.schema.json",
  "title": "Cross-Disciplinary Coherence Matrix",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project_id",
    "matrix_version",
    "source_artifacts",
    "rows",
    "summary"
  ],
  "properties": {
    "project_id": {
      "type": "string"
    },
    "matrix_version": {
      "type": "string"
    },
    "source_artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/coherence_row"
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_rows",
        "blockers",
        "major_issues",
        "accepted_risks",
        "planner_status"
      ],
      "properties": {
        "total_rows": {
          "type": "integer",
          "minimum": 0
        },
        "blockers": {
          "type": "integer",
          "minimum": 0
        },
        "major_issues": {
          "type": "integer",
          "minimum": 0
        },
        "accepted_risks": {
          "type": "integer",
          "minimum": 0
        },
        "planner_status": {
          "enum": [
            "draft",
            "needs_revision",
            "approved_for_generation",
            "approved_for_runtime",
            "blocked"
          ]
        }
      }
    }
  },
  "$defs": {
    "coherence_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_id",
        "row_type",
        "story_cell_id",
        "story_purpose",
        "player_must_understand",
        "characters_present",
        "knowledge_boundaries",
        "narrative_requirements",
        "visual_evidence_required",
        "assets_required",
        "ui_surfaces_required",
        "mechanics_and_state_changes",
        "video_requirement",
        "runtime_fields",
        "qa_acceptance",
        "coherence_status"
      ],
      "properties": {
        "row_id": {
          "type": "string"
        },
        "row_type": {
          "enum": [
            "story_cell",
            "choice",
            "failure",
            "ending",
            "asset",
            "ui_surface",
            "runtime_check"
          ]
        },
        "story_cell_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "story_purpose": {
          "type": "string"
        },
        "player_must_understand": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "characters_present": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "knowledge_boundaries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/knowledge_boundary"
          }
        },
        "narrative_requirements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "visual_evidence_required": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "assets_required": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/asset_requirement"
          }
        },
        "ui_surfaces_required": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ui_surface"
          }
        },
        "mechanics_and_state_changes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mechanic_requirement"
          }
        },
        "video_requirement": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "required",
            "reason",
            "video_slot_ids"
          ],
          "properties": {
            "required": {
              "type": "boolean"
            },
            "reason": {
              "type": "string"
            },
            "video_slot_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "runtime_fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "qa_acceptance": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "open_conflicts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/conflict"
          },
          "default": []
        },
        "planner_resolution": {
          "type": [
            "string",
            "null"
          ]
        },
        "coherence_status": {
          "enum": [
            "draft",
            "pass",
            "needs_revision",
            "blocked",
            "accepted_risk"
          ]
        }
      }
    },
    "knowledge_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fact",
        "known_by",
        "must_not_be_known_by"
      ],
      "properties": {
        "fact": {
          "type": "string"
        },
        "known_by": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "must_not_be_known_by": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "asset_requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_slot_id",
        "asset_type",
        "required_for_runtime",
        "fallback"
      ],
      "properties": {
        "asset_slot_id": {
          "type": "string"
        },
        "asset_type": {
          "enum": [
            "background",
            "character_reference",
            "character_pose",
            "character_expression",
            "prop",
            "story_still",
            "video_first_frame",
            "video_clip",
            "ui_concept",
            "ui_runtime_asset",
            "audio"
          ]
        },
        "required_for_runtime": {
          "type": "boolean"
        },
        "fallback": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "ui_surface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_id",
        "surface_type",
        "purpose"
      ],
      "properties": {
        "surface_id": {
          "type": "string"
        },
        "surface_type": {
          "enum": [
            "dialogue_box",
            "narration_box",
            "phone_overlay",
            "right_top_hint",
            "memory_log",
            "choice_overlay",
            "ending_card",
            "hud_status",
            "profile_panel"
          ]
        },
        "purpose": {
          "type": "string"
        }
      }
    },
    "mechanic_requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mechanic_id",
        "mechanic_type",
        "effect"
      ],
      "properties": {
        "mechanic_id": {
          "type": "string"
        },
        "mechanic_type": {
          "enum": [
            "choice",
            "state_change",
            "route_gate",
            "failure_condition",
            "ending_condition",
            "memory_unlock",
            "relationship_echo",
            "ui_feedback"
          ]
        },
        "effect": {
          "type": "string"
        }
      }
    },
    "conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conflict_id",
        "severity",
        "description",
        "reported_by"
      ],
      "properties": {
        "conflict_id": {
          "type": "string"
        },
        "severity": {
          "enum": [
            "blocker",
            "major",
            "minor",
            "accepted_risk"
          ]
        },
        "description": {
          "type": "string"
        },
        "reported_by": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
